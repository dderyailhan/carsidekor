@page
@model CarsiDekor.Web.Pages.Admin.PasswordModel
@{
    ViewData["Title"] = "Şifre değiştir";
}

<div class="page-bar">
    <h1>Şifre değiştir</h1>
</div>

<div class="panel" style="max-width:520px">
    <form method="post" novalidate>
        <div class="mb-3">
            <label asp-for="Input.CurrentPassword" class="form-label">Mevcut şifre</label>
            <input asp-for="Input.CurrentPassword" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Input.CurrentPassword" class="field-error"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.NewPassword" class="form-label">Yeni şifre</label>
            <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Input.NewPassword" class="field-error"></span>
            <div class="hint mt-1">En az 8 karakter.</div>
        </div>
        <div class="mb-4">
            <label asp-for="Input.ConfirmPassword" class="form-label">Yeni şifre (tekrar)</label>
            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
        </div>
        <button type="submit" class="btn btn-ruby">Şifreyi değiştir</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

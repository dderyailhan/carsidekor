@page
@model CarsiDekor.Web.Pages.Admin.Categories.IndexModel
@{
    ViewData["Title"] = "Kategoriler";
}

<div class="page-bar">
    <h1>Kategoriler</h1>
    <a class="btn btn-ruby" asp-page="/Admin/Categories/Edit">Yeni kategori ekle</a>
</div>

@if (Model.Rows.Any())
{
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th></th>
                    <th>Kategori</th>
                    <th>Slug</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <td style="width:64px">
                        @if (!string.IsNullOrEmpty(row.Category.CoverImagePath))
                        {
                            <img src="@row.Category.CoverImagePath" alt="" style="width:54px;height:40px;object-fit:cover;border-radius:4px" />
                        }
                        else
                        {
                            <span class="hint">—</span>
                        }
                    </td>
                    <td>@string.Concat(Enumerable.Repeat("— ", row.Depth))@row.Category.Name</td>
                    <td>@row.Category.Slug</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-dark" asp-page="/Admin/Categories/Edit" asp-route-id="@row.Category.Id">Düzenle</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@row.Category.Id" class="d-inline"
                              onsubmit="return confirm('Bu kategoriyi silmek istediğinize emin misiniz?')">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="panel">
        <p class="mb-3">Henüz kategori yok.</p>
        <a class="btn btn-ruby" asp-page="/Admin/Categories/Edit">İlk kategoriyi ekle</a>
    </div>
}

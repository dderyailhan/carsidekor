@page
@model CarsiDekor.Web.Pages.Projects.IndexModel
@{
    ViewData["Title"] = "Kategoriler";
    ViewData["Description"] = "Çarşı Dekor'un vitrin, banko, niş, manken ve diğer sergileme kategorileri.";

    // İlk açılışta seçili olacak kategori: en üstteki ana kategori
    var firstId = Model.Tree.Select(t => t.Id).FirstOrDefault();
    var navVd = new ViewDataDictionary(ViewData) { ["FirstId"] = firstId };
}

<section class="page-hero">
    <div class="container">
        <h1>Kategoriler</h1>
        <p>Kuyumcular için hazırladığımız vitrin ve sergileme işleri.</p>
    </div>
</section>

<section class="section section-tight">
    <div class="container">
        @if (Model.Tree.Any())
        {
            <div class="proj-layout">
                <nav class="proj-sidebar" aria-label="Kategoriler">
                    @foreach (var top in Model.Tree)
                    {
                        <partial name="_CategoryNav" model="top" view-data="navVd" />
                    }
                </nav>

                <div class="proj-content">
                    @* Her kategori (hangi seviyede olursa olsun) için bir panel *@
                    @foreach (var node in Model.Tree.SelectMany(t => t.Flatten()))
                    {
                        <div class="proj-panel @(node.Id == firstId ? "is-active" : "")" id="panel-@node.Id"
                             data-cat-panel data-nav="panel-@node.NavId" data-slug="@node.Slug">

                            @if (node.Depth > 0)
                            {
                                <div class="proj-crumbs">
                                    @foreach (var a in node.Ancestors())
                                    {
                                        <button type="button" data-goto="panel-@a.Id">@a.Name</button>
                                        <span>/</span>
                                    }
                                    <span class="now">@node.Name</span>
                                </div>
                            }

                            <div class="proj-panel-head">
                                <h2>@node.Name</h2>
                                @if (!node.IsLeaf)
                                {
                                    <span>@node.Children.Count alt kategori</span>
                                }
                                else if (node.PhotoCount > 0)
                                {
                                    <span>@node.PhotoCount fotoğraf</span>
                                }
                            </div>

                            @if (!node.IsLeaf)
                            {
                                <div class="proj-cards">
                                    @foreach (var child in node.Children)
                                    {
                                        <button type="button" class="proj-card" data-goto="panel-@child.Id">
                                            @if (!string.IsNullOrEmpty(child.Thumb))
                                            {
                                                <img src="@child.Thumb" alt="" loading="lazy" />
                                            }
                                            <span class="proj-card-body">
                                                <span class="proj-card-name">@child.Name</span>
                                                <span class="proj-card-meta">
                                                    @if (child.IsLeaf)
                                                    {
                                                        <span>@child.PhotoCount fotoğraf</span>
                                                    }
                                                    else
                                                    {
                                                        <span>@child.Children.Count tip</span>
                                                    }
                                                    <span class="proj-card-arrow" aria-hidden="true">→</span>
                                                </span>
                                            </span>
                                            <span class="proj-card-bar"></span>
                                        </button>
                                    }
                                </div>
                            }

                            <partial name="_CategoryGallery" model="node" />
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="empty-state">
                <p>Henüz kategori eklenmedi.</p>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script src="~/js/category-tabs.js"></script>
}
